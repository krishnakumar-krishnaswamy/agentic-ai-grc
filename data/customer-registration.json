{
  "metadata": {
    "id": "customer-registration",
    "name": "Customer Registration Agent",
    "description": "Autonomous agent responsible for onboarding new customers by coordinating identity, consent, customer data, and communication capabilities across enterprise systems.",
    "domain": "Customer Contact Center"
  },

  "agentCollaboration": [
  {
    "sequence": 1,
    "agent": "Identity Verification Agent",
    "purpose": "Verifies customer identity information during registration."
  },
  {
    "sequence": 2,
    "agent": "Consent Management Agent",
    "purpose": "Manages customer consent capture and privacy preferences."
  },
  {
    "sequence": 3,
    "agent": "Customer Data Agent",
    "purpose": "Validates and manages customer profile information."
  },
  {
    "sequence": 4,
    "agent": "Notification Agent",
    "purpose": "Communicates registration outcomes and customer updates."
  }
],

  "actions": [
  {
    "sequence": 1,
    "name": "Create Customer Identity",
    "enterpriseSystems": [
      "CIAM / Identity Platform"
    ],
    "governance": [
      "Agent Identity Management",
      "AI Agent Accountability",
      "Identity Lifecycle Governance"
    ],
    "risks": [
      "Identity Fraud Risk",
      "Unauthorized Identity Creation Risk",
      "Identity Data Exposure Risk"
    ],
 "compliance": [
  {
    "framework": "NIST AI RMF"
  },
  {
    "framework": "ISO/IEC 42001"
  },
  {
    "framework": "ISO 27001"
  }
]
  },
  {
    "sequence": 2,
    "name": "Capture Customer Consent",
    "enterpriseSystems": [
      "Consent Management Platform"
    ],
    "governance": [
      "Consent Governance",
      "Data Usage Governance",
      "Privacy Policy Governance"
    ],
    "risks": [
      "Consent Misuse Risk",
      "Privacy Violation Risk",
      "Incorrect Consent Capture Risk"
    ]
  },
  {
    "sequence": 3,
    "name": "Validate Registration Data",
    "enterpriseSystems": [
      "CRM / Customer Data Platform",
      "Data Quality Services"
    ],
    "governance": [
      "Data Governance",
      "Data Quality Governance",
      "Validation Policy Governance"
    ],
    "risks": [
      "Incorrect Data Validation Risk",
      "Poor Data Quality Risk",
      "Decision Accuracy Risk"
    ]
  },
  {
    "sequence": 4,
    "name": "Store Customer Profile",
    "enterpriseSystems": [
      "CRM Platform",
      "Customer Data Repository"
    ],
    "governance": [
      "Data Ownership Governance",
      "Access Governance",
      "Information Lifecycle Governance"
    ],
    "risks": [
