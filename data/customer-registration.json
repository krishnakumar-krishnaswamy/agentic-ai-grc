      "Data Retention Risk",
      "Customer Information Exposure Risk"
    ]
  },
  {
    "sequence": 5,
    "name": "Send Registration Confirmation",
    "enterpriseSystems": [
      "Notification Platform",
      "Communication Services"
    ],
    "governance": [
      "Communication Governance",
      "Customer Notification Governance",
      "Audit Governance"
    ],
    "risks": [
      "Incorrect Customer Communication Risk",
      "Information Disclosure Risk",
      "Notification Failure Risk"
    ]
  }
  ],

